# ==============================================================================
# SMART GOLU - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your real secrets (.env.local) to version control!

# ------------------------------------------------------------------------------
# 1. SUPABASE PUBLIC CONFIGURATION (Safe for browser client)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Project Settings -> API -> Project URL & Project API Keys (anon public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your_anon_or_publishable_key_here

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVER SECRETS (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Project Settings -> API -> Project API Keys (service_role)
# Used exclusively by /api/doll server route to authenticate and write updates to the database
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. HARDWARE AUTHENTICATION TOKEN (SERVER & ESP8266 ONLY)
# ------------------------------------------------------------------------------
# A secure, random token shared between your NodeMCU ESP8266 and the Next.js API route.
# The ESP8266 must send this in the 'x-device-token' header when sending POST /api/doll.
# Example: generate a 32-character string (e.g. openssl rand -hex 16)
DEVICE_TOKEN=golu_sec_device_token_9f8a3c42e1

# ------------------------------------------------------------------------------
# 4. OPTIONAL DEPLOYMENT URL FOR QR CODE
# ------------------------------------------------------------------------------
# If left blank, the frontend dynamically uses window.location.origin.
# Set this to your canonical production URL (e.g., https://smart-golu.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
